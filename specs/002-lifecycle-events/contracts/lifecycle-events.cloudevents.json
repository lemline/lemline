{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lemline Lifecycle CloudEvents",
  "description": "JSON Schema for Serverless Workflow Lifecycle Events emitted by Lemline",
  "definitions": {
    "cloudEventBase": {
      "type": "object",
      "required": ["specversion", "id", "source", "type", "time", "datacontenttype"],
      "properties": {
        "specversion": {
          "type": "string",
          "const": "1.0",
          "description": "CloudEvents specification version"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique event identifier (UUID v7)"
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^urn:lemline:workflow:.+:.+:.+$",
          "description": "Event source (urn:lemline:workflow:{namespace}:{name}:{version})"
        },
        "type": {
          "type": "string",
          "description": "Event type"
        },
        "time": {
          "type": "string",
          "format": "date-time",
          "description": "Event timestamp (ISO 8601)"
        },
        "datacontenttype": {
          "type": "string",
          "const": "application/json"
        },
        "lemlineworkflowid": {
          "type": "string",
          "format": "uuid",
          "description": "Workflow instance ID"
        },
        "lemlineworkflownamespace": {
          "type": "string",
          "description": "Workflow namespace"
        },
        "lemlineworkflowname": {
          "type": "string",
          "description": "Workflow name"
        },
        "lemlineworkflowversion": {
          "type": "string",
          "description": "Workflow version"
        }
      }
    },
    "workflowDefinition": {
      "type": "object",
      "required": ["namespace", "name", "version"],
      "properties": {
        "namespace": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "errorInfo": {
      "type": "object",
      "required": ["type", "status", "title"],
      "properties": {
        "type": {
          "type": "string",
          "format": "uri",
          "description": "Error type URI"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599,
          "description": "HTTP-like status code"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable error title"
        }
      }
    },
    "workflowCreatedData": {
      "type": "object",
      "required": ["name", "input", "createdAt", "definition"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Qualified workflow name (namespace/name:version)"
        },
        "input": {
          "type": "object",
          "description": "Workflow input data"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "definition": { "$ref": "#/definitions/workflowDefinition" }
      },
      "description": "Lemline extension - not part of Serverless Workflow spec"
    },
    "workflowStartedData": {
      "type": "object",
      "required": ["name", "startedAt", "definition"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Qualified workflow name (namespace/name:version)"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "definition": { "$ref": "#/definitions/workflowDefinition" }
      }
    },
    "workflowCompletedData": {
      "type": "object",
      "required": ["name", "output", "completedAt"],
      "properties": {
        "name": { "type": "string" },
        "output": {
          "type": "object",
          "description": "Workflow output data"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "workflowFaultedData": {
      "type": "object",
      "required": ["name", "faultedAt", "error"],
      "properties": {
        "name": { "type": "string" },
        "faultedAt": {
          "type": "string",
          "format": "date-time"
        },
        "error": { "$ref": "#/definitions/errorInfo" }
      }
    },
    "taskCreatedData": {
      "type": "object",
      "required": ["workflow", "task", "input", "createdAt"],
      "properties": {
        "workflow": {
          "type": "string",
          "description": "Qualified workflow name"
        },
        "task": {
          "type": "string",
          "pattern": "^/.*$",
          "description": "JSON Pointer to task in workflow definition"
        },
        "input": {
          "type": "object",
          "description": "Task input data"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "taskStartedData": {
      "type": "object",
      "required": ["workflow", "task", "startedAt"],
      "properties": {
        "workflow": {
          "type": "string",
          "description": "Qualified workflow name"
        },
        "task": {
          "type": "string",
          "pattern": "^/.*$",
          "description": "JSON Pointer to task in workflow definition"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "taskCompletedData": {
      "type": "object",
      "required": ["workflow", "task", "output", "completedAt"],
      "properties": {
        "workflow": { "type": "string" },
        "task": {
          "type": "string",
          "pattern": "^/.*$"
        },
        "output": {
          "type": "object",
          "description": "Task output data"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "taskFaultedData": {
      "type": "object",
      "required": ["workflow", "task", "faultedAt", "error"],
      "properties": {
        "workflow": { "type": "string" },
        "task": {
          "type": "string",
          "pattern": "^/.*$"
        },
        "faultedAt": {
          "type": "string",
          "format": "date-time"
        },
        "error": { "$ref": "#/definitions/errorInfo" }
      }
    },
    "taskRetriedData": {
      "type": "object",
      "required": ["workflow", "task", "retriedAt", "retryCount"],
      "properties": {
        "workflow": { "type": "string" },
        "task": {
          "type": "string",
          "pattern": "^/.*$"
        },
        "retriedAt": {
          "type": "string",
          "format": "date-time"
        },
        "retryCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Current retry attempt number (1-based)"
        }
      }
    }
  },
  "oneOf": [
    {
      "allOf": [
        { "$ref": "#/definitions/cloudEventBase" },
        {
          "properties": {
            "type": { "const": "io.serverlessworkflow.workflow.created.v1" },
            "data": { "$ref": "#/definitions/workflowCreatedData" }
          },
          "required": ["data"],
          "description": "Lemline extension - not part of Serverless Workflow spec"
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/definitions/cloudEventBase" },
        {
          "properties": {
            "type": { "const": "io.serverlessworkflow.workflow.started.v1" },
            "data": { "$ref": "#/definitions/workflowStartedData" }
          },
          "required": ["data"]
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/definitions/cloudEventBase" },
        {
          "properties": {
            "type": { "const": "io.serverlessworkflow.workflow.completed.v1" },
            "data": { "$ref": "#/definitions/workflowCompletedData" }
          },
          "required": ["data"]
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/definitions/cloudEventBase" },
        {
          "properties": {
            "type": { "const": "io.serverlessworkflow.workflow.faulted.v1" },
            "data": { "$ref": "#/definitions/workflowFaultedData" }
          },
          "required": ["data"]
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/definitions/cloudEventBase" },
        {
          "properties": {
            "type": { "const": "io.serverlessworkflow.task.created.v1" },
            "data": { "$ref": "#/definitions/taskCreatedData" }
          },
          "required": ["data"]
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/definitions/cloudEventBase" },
        {
          "properties": {
            "type": { "const": "io.serverlessworkflow.task.started.v1" },
            "data": { "$ref": "#/definitions/taskStartedData" }
          },
          "required": ["data"]
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/definitions/cloudEventBase" },
        {
          "properties": {
            "type": { "const": "io.serverlessworkflow.task.completed.v1" },
            "data": { "$ref": "#/definitions/taskCompletedData" }
          },
          "required": ["data"]
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/definitions/cloudEventBase" },
        {
          "properties": {
            "type": { "const": "io.serverlessworkflow.task.faulted.v1" },
            "data": { "$ref": "#/definitions/taskFaultedData" }
          },
          "required": ["data"]
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/definitions/cloudEventBase" },
        {
          "properties": {
            "type": { "const": "io.serverlessworkflow.task.retried.v1" },
            "data": { "$ref": "#/definitions/taskRetriedData" }
          },
          "required": ["data"]
        }
      ]
    }
  ]
}
